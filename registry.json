    {
      "name": "shell-layout",
      "type": "registry:block",
      "title": "App shell: layout",
      "description": "<AppShell>: an icon rail on a canvas, one rounded content card with a resizable, foldable space panel per space, a mobile sheet, Cmd/Ctrl+B / Cmd/Ctrl+K / C shortcuts and a navigation progress bar. Plus the one-row <PageHeader>, <IconButton> and the panel building blocks (PanelFrame, PanelSection, PanelRow, PanelAllRow).",
      "dependencies": ["react-resizable-panels", "cn", "lucide-react"],
      "registryDependencies": [
        "button",
        "tooltip",
        "dropdown-menu",
        "context-menu",
        "resizable",
        "scroll-area",
        "sheet",
        "@cdlab/shell-core"
      ],
      "css": {
        "@keyframes shell-nav-progress": {
          "from": {
            "transform": "translateX(-100%)"
          },
          "to": {
            "transform": "translateX(300%)"
          }
        }
      },
