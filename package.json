{
  "name": "@cdlab/appshell",
  "version": "0.4.2",
  "private": true,
  "description": "A dashboard app shell (rail, content card, space panels, page header, list menus, search dialog, intro) shipped as a shadcn registry under @cdlab.",
  "homepage": "https://github.com/wuchendi/appshell",
  "bugs": {
    "url": "https://github.com/wuchendi/appshell/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuchendi/appshell.git"
  },
  "license": "MIT",
  "author": "wudi <wuchendi96@gmail.com>",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun test registry",
    "test:coverage": "bun test registry --coverage",
    "registry:build": "shadcn build registry.json --output public/r",
    "build": "bun run registry:build && bun run --filter '*' build",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "registry:smoke": "bash scripts/registry-smoke.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "next": "16.4.6",
    "shadcn": "catalog:",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "catalog": {
    "shadcn": "4.23.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
